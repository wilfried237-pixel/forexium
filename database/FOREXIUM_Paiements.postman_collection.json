                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"montant\": 10000,\n  \"devise\": \"XAF\",\n  \"transaction_id\": \"TX_456\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/payments/fournisseurs/1/pay",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments", "fournisseurs", "1", "pay"]
            },
            "description": "Enregistre un paiement au fournisseur en XAF"
          },
          "response": []
        },
        {
          "name": "Payer un fournisseur (USDT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"montant\": 50.5,\n  \"devise\": \"USDT\",\n  \"transaction_id\": \"TX_456\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/payments/fournisseurs/1/pay",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments", "fournisseurs", "1", "pay"]
            },
            "description": "Enregistre un paiement au fournisseur en USDT"
          },
          "response": []
        },
        {
          "name": "Payer sans lier à une transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"montant\": 5000,\n  \"devise\": \"XAF\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/payments/fournisseurs/1/pay",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments", "fournisseurs", "1", "pay"]
            },
            "description": "Enregistre un paiement sans le lier à une transaction spécifique (paiement global)"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "TOKEN",
      "value": "YOUR_BEARER_TOKEN",
      "type": "string"
    }
  ]
