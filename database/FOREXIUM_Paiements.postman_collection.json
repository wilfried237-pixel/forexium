            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/payments/fournisseurs/1/account",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments", "fournisseurs", "1", "account"]
            },
            "description": "Récupère l'extrait complet d'un fournisseur avec soldes et historique des paiements"
          },
          "response": []
        },
        {
          "name": "Payer un fournisseur (XAF)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN",
                "type": "text"
