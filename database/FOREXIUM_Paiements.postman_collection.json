{
  "info": {
    "name": "FOREXIUM - Paiements Clients & Fournisseurs",
    "description": "Collection d'endpoints pour tester le système de paiements",
    "version": "1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CLIENTS - Paiements",
      "item": [
        {
          "name": "Récupérer l'extrait d'un client",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/payments/clients/1/account",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments", "clients", "1", "account"]
            },
            "description": "Récupère l'extrait complet d'un client avec toutes ses transactions et le reste à payer"
          },
          "response": []
        },
        {
          "name": "Enregistrer un paiement client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"montant_paye\": 5000,\n  \"devise_paiement\": \"XAF\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/payments/clients/1/transaction/TX_123",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments", "clients", "1", "transaction", "TX_123"]
            },
            "description": "Enregistre un paiement partiel pour une transaction spécifique d'un client"
          },
          "response": []
        }
      ]
    },
    {
      "name": "FOURNISSEURS - Paiements",
